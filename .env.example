# ============================================================
# CONTINENTAL PROJECT — AGENT 3 — Environment Variables
# ============================================================

# ── Xero OAuth credentials ───────────────────────────────────
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_1_here
XERO_REDIRECT_URI=https://continental-agent-3.onrender.com/xero/callback

# ── Set after OAuth flow (run /xero/auth to generate) ───────
XERO_REFRESH_TOKEN=PENDING_OAUTH_FLOW
XERO_TENANT_ID=PENDING_OAUTH_FLOW

# ── Server ───────────────────────────────────────────────────
PORT=10000
